+# Environment construction (merged with CLI flags by train_safety_gymnasium.py;
+# --no_hidden_goal overrides). hidden_goal is REQUIRED for meta-learning: it
+# removes goal_lidar from the observation so the goal is a latent task variable,
+# not a goal-conditioned input.
+env:
+  hidden_goal: true
+  hidden_goal_continue: false
+
 algorithm:
   class_name: P3O
+  cost_limits: [15.0]       # inner P3O constraint; aligned with meta.cost_limit
   # training parameters copied from PPO for closer comparison
   normalize_advantage_per_mini_batch: false
   value_loss_coef: 1.0
@@ -60,6 +69,10 @@ meta:
   meta_cost_protect_std: true # Fix A: keep exploration std out of the cost step (only reshape the mean)
   eta_deadband: true        # only run the cost step while meta_policy_cost > limit (stop eroding reward once safe)
   seed_pool: [0, 1, 3, 4, 5, 7, 8, 14, 16, 18, 19, 22, 23, 24, 25, 26, 30, 34, 35, 38]
+  # Held-out tasks for the adaptation eval (scripts/eval/eval_cmaml_adaptation.py).
+  # Must stay disjoint from seed_pool — enforced at runner construction.
+  held_out_seeds: [2, 6, 9, 10, 11, 12, 13, 15, 17, 20]
+  # allow_goal_obs: true    # explicit goal-conditioned ABLATION (bypasses the hidden-goal guard)
 
 runner:
   num_steps_per_env: 2048
