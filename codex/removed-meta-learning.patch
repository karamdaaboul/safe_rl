+    def _validate_hidden_goal(env, meta_cfg: dict) -> None:
+        """Refuse to meta-train on a goal-observing env unless explicitly opted out.
+
+        With the goal in the observation the 'tasks' are not latent and cMAML
+        collapses to goal-conditioned RL; `meta.allow_goal_obs: true` is the
+        explicit escape hatch for that ablation.
+        """
+        if bool(meta_cfg.get("allow_goal_obs", False)):
+            print("[cMAML] WARNING: meta.allow_goal_obs=true — goal-conditioned ABLATION mode, not meta-learning.")
