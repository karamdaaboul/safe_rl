+    def load(self, path: str, load_optimizer: bool = True):
+        """Load a checkpoint and re-sync the meta-parameter snapshots.
+
+        Checkpoints hold the meta-parameters (`learn` restores them into the live
+        policy before saving), but the snapshots in `meta_actor_params` /
+        `meta_cost_params` are taken at construction — without this re-sync,
+        `_load_meta_into_policy()` would clobber the loaded weights with the
+        stale random init. The reward-critic init (`value_init_params`)
+        deliberately stays fresh: it is re-initialized per task by design.
+        """
+        infos = super().load(path, load_optimizer)
+        with torch.no_grad():
+            for name, p in self.alg.policy.named_parameters():
+                if name in self.meta_actor_params:
+                    self.meta_actor_params[name].copy_(p.detach())
+                elif name in self.meta_cost_params:
+                    self.meta_cost_params[name].copy_(p.detach())
+        return infos
